{
  "name": "sentrilearn-backend",
  "version": "2.0.0",
  "description": "SentriLearn backend — SQLite-backed cybersecurity awareness platform with optional Gemini-assisted practice generation",
  "main": "src/app.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src/**/*.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed:demo": "node src/db/seedDemo.js",
    "db:seed:showcase": "node src/db/seedDemo.js --with-showcase",
    "db:reset": "node src/db/resetDev.js",
    "db:backup": "node src/db/backup.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
