# =============================================
# SENTRILEARN BACKEND - ENVIRONMENT CONFIG
# =============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Path is relative to backend/ unless absolute. Kept out of Git and
# out of any publicly served folder.
DATABASE_PATH=data/sentrilearn.sqlite

# Session & CSRF secrets — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dev falls back to an insecure placeholder; production refuses to start without real values.
SESSION_SECRET=replace_with_a_random_64_char_hex_string
CSRF_SECRET=replace_with_a_different_random_64_char_hex_string

# Cookie domain — leave unset for localhost development.
# COOKIE_DOMAIN=

# Session lifetimes (milliseconds)
SESSION_TTL_MS=7200000
REMEMBER_ME_TTL_MS=2592000000

# Login rate limiting
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_ATTEMPTS=10

# Google Gemini AI Configuration (OPTIONAL — AI-generated practice is
# disabled with a clear message if this is not set; nothing else
# depends on it)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
AI_GENERATION_WINDOW_MS=600000
AI_GENERATION_MAX_PER_WINDOW=8

# CORS Configuration — exact frontend origin (credentialed requests
# cannot use a wildcard)
FRONTEND_URL=http://localhost:5173

# Global API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
